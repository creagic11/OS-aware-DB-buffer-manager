# Runs bench_runner twice with the same seed and checks that
#  - the summary CSV / JSON / trace files exist and have the documented columns
#  - the op sequence dump is byte-identical across invocations (determinism)
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})
foreach(i 1 2)
  execute_process(COMMAND ${RUNNER} --pattern=hotspot --keys=500 --ops=3000 --runs=2 --pool=16
                          --dir=${OUT} --summary=${OUT}/summary.csv --json=${OUT}/r.json
                          --trace=${OUT}/trace.csv --quiet RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "bench_runner failed (${rc})")
  endif()
  execute_process(COMMAND ${RUNNER} --pattern=zipf --keys=500 --ops=3000 --dump-ops=${OUT}/ops${i}.csv
                  RESULT_VARIABLE rc OUTPUT_QUIET)
endforeach()
file(STRINGS ${OUT}/summary.csv lines)
list(LENGTH lines n)
if(NOT n EQUAL 5)
  message(FATAL_ERROR "summary.csv should have header + 4 rows, has ${n}")
endif()
list(GET lines 0 header)
foreach(col label run pattern throughput_ops p50_us p99_us hit_ratio io_iops cache_state os_cache_resident_before)
  string(FIND "${header}" "${col}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "summary.csv missing column ${col}")
  endif()
endforeach()
file(STRINGS ${OUT}/trace_run1.csv t LIMIT_COUNT 1)
if(NOT t STREQUAL "seq,op,key,latency_ns")
  message(FATAL_ERROR "trace header wrong: ${t}")
endif()
file(SHA256 ${OUT}/ops1.csv h1)
file(SHA256 ${OUT}/ops2.csv h2)
if(NOT h1 STREQUAL h2)
  message(FATAL_ERROR "op dumps differ: workload is not deterministic")
endif()
file(READ ${OUT}/r.json j)
string(FIND "${j}" "\"aggregate\"" pos)
if(pos EQUAL -1)
  message(FATAL_ERROR "JSON missing aggregate")
endif()
